{
  "schema_version": "0.2-experimental",
  "extension_id": "org.vllm-hust.lmcache-provider",
  "extension_version": "0.2.0.dev0",
  "kind": "kv_service_adapter",
  "host": {
    "provider": "lmcache",
    "name": "LMCache",
    "version_range": ">=0",
    "api_range": ">=1,<2"
  },
  "runtime": {
    "type": "composite",
    "process_scope": "external_service_and_vllm_connector",
    "isolation": "external_service"
  },
  "lifecycle_owner": "external_operator",
  "protocols": [
    {"name": "lmcache-mp-service", "version_range": ">=1,<2"},
    {"name": "vllm-kv-connector", "version_range": ">=1,<2"}
  ],
  "implementation": [
    {
      "type": "external_service",
      "service": "LMCache MP server",
      "module": "lmcache.v1.multiprocess.http_server"
    },
    {
      "type": "host_builtin",
      "host": "vllm",
      "symbols": ["LMCacheMPConnector", "LMCacheConnectorV1"]
    },
    {
      "type": "python_entry_point",
      "module": "lmcache.integration.vllm.lmcache_mp_connector"
    }
  ],
  "requires_services": [
    {
      "service_id": "lmcache-mp-server",
      "protocol": "http-health",
      "version_range": ">=1,<2",
      "endpoint_config": "health_url",
      "optional": false
    }
  ]
}
