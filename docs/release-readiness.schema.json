{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-hust.github.io/extension-manager/release-readiness.schema.json",
  "title": "ECPA release-readiness decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessed_at",
    "package_version",
    "manifest_api",
    "decision",
    "publication_authorized",
    "inventory",
    "gates"
  ],
  "properties": {
    "$schema": {"const": "./release-readiness.schema.json"},
    "schema_version": {"const": "1.0"},
    "assessed_at": {"type": "string", "format": "date"},
    "package_version": {"type": "string", "minLength": 1},
    "manifest_api": {"type": "string", "minLength": 1},
    "decision": {"enum": ["go", "no-go"]},
    "publication_authorized": {"type": "boolean"},
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distributions",
        "registrations",
        "activation_intent",
        "inspect_only"
      ],
      "properties": {
        "distributions": {"type": "integer", "minimum": 0},
        "registrations": {"type": "integer", "minimum": 0},
        "activation_intent": {"type": "integer", "minimum": 0},
        "inspect_only": {"type": "integer", "minimum": 0}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "required", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["passed", "blocked"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "remaining_action": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "blocked"}}},
            "then": {"required": ["remaining_action"]}
          }
        ]
      }
    }
  }
}
