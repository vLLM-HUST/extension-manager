[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = "stateaxis-pipelined-weight-loading"
version = "0.2.0"
description = "Artifact-bound StateAxis pinned double-buffer asynchronous weight loader"
readme = "README.md"
requires-python = ">=3.10"
license = "Apache-2.0"
dependencies = []

[project.optional-dependencies]
test = ["pytest>=8", "ruff>=0.12"]

[project.entry-points."vllm_hust.extension_bundles"]
"org.vllm-hust.stateaxis-pipelined-weight-loading" = "stateaxis_pipelined_weight_loading"

[project.entry-points."stateaxis.mod_handlers"]
pipelined_weight_loading = "stateaxis_pipelined_weight_loading:pipelined_weight_loading"

[tool.hatch.build.targets.wheel]
packages = ["src/stateaxis_pipelined_weight_loading"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
target-version = "py310"
line-length = 88

[tool.ruff.lint]
select = ["B", "E", "F", "I", "SIM", "UP"]
