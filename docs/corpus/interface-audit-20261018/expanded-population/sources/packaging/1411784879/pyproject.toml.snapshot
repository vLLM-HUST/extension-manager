[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = "stateaxis-async-kv-transfer"
version = "0.2.0"
description = "Bounded identity-safe asynchronous KV transfer MOD for StateAxis"
readme = "README.md"
requires-python = ">=3.10"
license = "Apache-2.0"
dependencies = []

[project.optional-dependencies]
test = ["pytest>=8", "ruff>=0.12", "vllm-hust-ext>=0.3,<0.4"]

[project.entry-points."vllm_hust.extension_bundles"]
"org.vllm-hust.stateaxis-async-kv-transfer" = "stateaxis_async_kv_transfer"

[project.entry-points."stateaxis.mod_handlers"]
async_kv_transfer = "stateaxis_async_kv_transfer:async_kv_transfer"

[tool.hatch.build.targets.wheel]
packages = ["src/stateaxis_async_kv_transfer"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
target-version = "py310"
line-length = 88

[tool.ruff.lint]
select = ["B", "E", "F", "I", "SIM", "UP"]
