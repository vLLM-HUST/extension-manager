[build-system]
requires = ["setuptools>=77.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "vllm-hust-opset"
dynamic = ["version"]
description = "Pluggable kernel replacements and operator fusions for the vLLM-HUST Ascend backend"
readme = "README.md"
license = "Apache-2.0"
requires-python = ">=3.10"
dependencies = []
classifiers = [
  "Development Status :: 3 - Alpha",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3 :: Only",
  "Operating System :: POSIX :: Linux",
]

[project.urls]
Homepage = "https://github.com/vLLM-HUST/vllm-hust-opset"
Repository = "https://github.com/vLLM-HUST/vllm-hust-opset"
Issues = "https://github.com/vLLM-HUST/vllm-hust-opset/issues"
Changelog = "https://github.com/vLLM-HUST/vllm-hust-opset/releases"

[project.scripts]
vllm-hust-opset = "vllm_hust_operator_optimizations.compatibility:main"
vllm-hust-operator-check = "vllm_hust_operator_optimizations.compatibility:main"

[project.entry-points."vllm_hust.extension_bundles"]
"org.vllm-hust.operator-optimizations" = "vllm_hust_operator_optimizations.manifests"

[project.entry-points."vllm.general_plugins"]
operator_optimizations = "vllm_hust_operator_optimizations.plugin:activate"

[tool.setuptools.dynamic]
version = {attr = "vllm_hust_operator_optimizations._version.__version__"}

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
vllm_hust_operator_optimizations = ["manifests/*.json", "compatibility/*.json"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 100
