[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = "stateaxis-automatic-prefix-cache"
version = "0.2.0"
description = "Lease-safe content-addressed prefix reuse for StateAxis"
readme = "README.md"
requires-python = ">=3.10"
license = "Apache-2.0"
dependencies = []

[project.optional-dependencies]
test = ["pytest>=8", "ruff>=0.12", "vllm-hust-ext>=0.3,<0.4"]

[project.entry-points."vllm_hust.extension_bundles"]
"org.vllm-hust.stateaxis-automatic-prefix-cache" = "stateaxis_automatic_prefix_cache"

[project.entry-points."stateaxis.mod_handlers"]
automatic_prefix_cache = "stateaxis_automatic_prefix_cache:automatic_prefix_cache"

[tool.hatch.build.targets.wheel]
packages = ["src/stateaxis_automatic_prefix_cache"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
target-version = "py310"
line-length = 88

[tool.ruff.lint]
select = ["B", "E", "F", "I", "SIM", "UP"]
