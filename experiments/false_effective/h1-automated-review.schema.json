{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-h1-automated-independent-review/v1",
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "check": {
      "type": "object",
      "required": ["verdict", "evidence_digest", "assertions"],
      "properties": {
        "verdict": {"const": "PASS"},
        "evidence_digest": {"$ref": "#/definitions/digest"},
        "assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "reviewer_kind", "human_review", "protocol_amendment", "subject", "checks", "machine_qualification_preserved", "official_files_mutated", "formal_h1_starts", "non_claims", "receipt_digest"],
  "properties": {
    "schema": {"const": "ecpa-h1-automated-independent-review/v1"},
    "reviewer_kind": {"const": "automated-independent"},
    "human_review": {"const": false},
    "protocol_amendment": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": {"const": "h1-review-mode-owner-amendment-2026-10-13"},
        "digest": {"$ref": "#/definitions/digest"}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["schema", "candidate_digest"],
      "properties": {
        "schema": {"const": "ecpa-h1-formal-registration-candidate/v1"},
        "candidate_digest": {"$ref": "#/definitions/digest"}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["commands", "activation_paths", "observer_independence", "artifact_retention"],
      "properties": {
        "commands": {"$ref": "#/definitions/check"},
        "activation_paths": {"$ref": "#/definitions/check"},
        "observer_independence": {"$ref": "#/definitions/check"},
        "artifact_retention": {"$ref": "#/definitions/check"}
      },
      "additionalProperties": false
    },
    "machine_qualification_preserved": {"const": true},
    "official_files_mutated": {"const": false},
    "formal_h1_starts": {"const": 0},
    "non_claims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "receipt_digest": {"$ref": "#/definitions/digest"}
  },
  "additionalProperties": false
}
