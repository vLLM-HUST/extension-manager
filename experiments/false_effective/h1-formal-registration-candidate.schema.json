{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fingerprint": {
      "type": "object",
      "required": ["executable", "executable_resolved", "executable_device", "executable_inode", "executable_sha256", "arguments", "argument_files", "digest"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "executable_resolved": {"type": "string", "minLength": 1},
        "executable_device": {"type": "integer", "minimum": 0},
        "executable_inode": {"type": "integer", "minimum": 1},
        "executable_sha256": {"$ref": "#/definitions/digest"},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "argument_files": {"type": "array", "items": {"type": "object"}},
        "digest": {"$ref": "#/definitions/digest"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "classification", "registration_state", "admissible", "formal_h1_starts", "experiment_manager_identity", "workspace", "inputs", "environment", "declared_identity", "schedule", "arms", "machine_checks", "independent_reviews", "remaining_blockers", "non_claims"],
  "properties": {
    "schema": {"const": "ecpa-h1-formal-registration-candidate/v1"},
    "classification": {"const": "deployment-bound-non-admitting-command-candidate"},
    "registration_state": {"const": "candidate-only"},
    "admissible": {"const": false},
    "formal_h1_starts": {"const": 0},
    "experiment_manager_identity": {"type": "object"},
    "workspace": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "environment": {"type": "object"},
    "declared_identity": {"type": "object"},
    "schedule": {"type": "array", "minItems": 9, "maxItems": 9},
    "arms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["arm", "activation_contract", "port", "workspace", "commands", "lifecycle_fact_commands", "activation_probe_observation", "runner_arguments", "registry_candidate"],
        "properties": {
          "arm": {"enum": ["vanilla-vllm-entry-points", "manual-integration", "ecpa"]},
          "activation_contract": {"type": "string"},
          "port": {"const": 8187},
          "workspace": {"type": "object"},
          "commands": {
            "type": "object",
            "minProperties": 3,
            "additionalProperties": {"$ref": "#/definitions/fingerprint"}
          },
          "lifecycle_fact_commands": {
            "type": "object",
            "required": ["service-ready", "workload-complete", "fault-injected", "observer-captured", "service-shutdown"],
            "properties": {
              "service-ready": {"$ref": "#/definitions/fingerprint"},
              "workload-complete": {"$ref": "#/definitions/fingerprint"},
              "fault-injected": {"$ref": "#/definitions/fingerprint"},
              "observer-captured": {"$ref": "#/definitions/fingerprint"},
              "service-shutdown": {"$ref": "#/definitions/fingerprint"}
            },
            "additionalProperties": false
          },
          "activation_probe_observation": {"type": ["object", "null"]},
          "runner_arguments": {"type": "object"},
          "registry_candidate": {
            "type": "object",
            "required": ["id", "arm", "admission", "activation_contract", "lifecycle_fact_command_digests", "observer_command_digest", "activation_probe", "scenario_bindings"],
            "properties": {"admission": {"type": "null"}},
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "machine_checks": {
      "type": "object",
      "required": ["three_arms_complete", "five_sources_per_arm_complete", "nine_start_schedule_complete", "activation_probes_executed"],
      "properties": {
        "three_arms_complete": {"const": true},
        "five_sources_per_arm_complete": {"const": true},
        "nine_start_schedule_complete": {"const": true},
        "activation_probes_executed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "independent_reviews": {
      "type": "object",
      "required": ["commands", "activation_paths", "observer_independence", "artifact_retention"],
      "properties": {
        "commands": {"type": "null"},
        "activation_paths": {"type": "null"},
        "observer_independence": {"type": "null"},
        "artifact_retention": {"type": "null"}
      },
      "additionalProperties": false
    },
    "remaining_blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 4, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
