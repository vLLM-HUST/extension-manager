{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-h1-producer-admission-issuance/v1",
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "type": "object",
  "required": ["schema", "admission", "bindings", "review_modes", "human_review_evidence", "machine_gates", "formal_h1_starts", "official_files_mutated", "non_claims", "receipt_digest"],
  "properties": {
    "schema": {"const": "ecpa-h1-producer-admission-issuance/v1"},
    "admission": {"type": "object"},
    "bindings": {
      "type": "object",
      "required": ["candidate_sha256", "review_sha256", "review_receipt_digest", "review_subject_candidate_sha256", "qualification_sha256", "producer_candidate_sha256", "source_commits"],
      "properties": {
        "candidate_sha256": {"$ref": "#/definitions/digest"},
        "review_sha256": {"$ref": "#/definitions/digest"},
        "review_receipt_digest": {"$ref": "#/definitions/digest"},
        "review_subject_candidate_sha256": {"$ref": "#/definitions/digest"},
        "qualification_sha256": {"$ref": "#/definitions/digest"},
        "producer_candidate_sha256": {"$ref": "#/definitions/digest"},
        "source_commits": {
          "type": "object",
          "required": ["host", "accelerator_plugin", "manager", "mod"],
          "properties": {
            "host": {"$ref": "#/definitions/git_sha"},
            "accelerator_plugin": {"$ref": "#/definitions/git_sha"},
            "manager": {"$ref": "#/definitions/git_sha"},
            "mod": {"$ref": "#/definitions/git_sha"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "review_modes": {
      "type": "object",
      "required": ["producer_source", "deployment_checks", "protocol_amendment"],
      "properties": {
        "producer_source": {"const": "existing-human-line-review"},
        "deployment_checks": {"const": "automated-independent"},
        "protocol_amendment": {"type": "object"}
      },
      "additionalProperties": false
    },
    "human_review_evidence": {
      "type": "object",
      "required": ["reviewer", "review_comment_id", "verdict", "reviewed_head"],
      "properties": {
        "reviewer": {"const": "Apei-520"},
        "review_comment_id": {"const": 5853006976},
        "verdict": {"const": "APPROVE"},
        "reviewed_head": {"const": "f3eb4b09ba91a1720c4e35de41a91e6dc351fd5b"}
      },
      "additionalProperties": false
    },
    "machine_gates": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"const": true}
    },
    "formal_h1_starts": {"const": 0},
    "official_files_mutated": {"const": false},
    "non_claims": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_digest": {"$ref": "#/definitions/digest"}
  },
  "additionalProperties": false
}
