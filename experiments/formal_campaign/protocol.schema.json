{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-formal-campaign-protocol/v1",
  "type": "object",
  "required": ["schema", "status", "evidence_class", "minimum_starts", "arms", "schedule", "h3", "h4"],
  "properties": {
    "schema": {"const": "ecpa-formal-campaign-protocol/v1"},
    "status": {"const": "planned"},
    "evidence_class": {"const": "formal-real"},
    "minimum_starts": {"const": 3},
    "arms": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "schedule": {"type": "array", "minItems": 3, "maxItems": 3},
    "h3": {"$ref": "#/definitions/campaign"},
    "h4": {"$ref": "#/definitions/campaign"}
  },
  "definitions": {
    "campaign": {
      "type": "object",
      "required": ["campaign_id", "required_cells", "prerequisites"],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "required_cells": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prerequisites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
