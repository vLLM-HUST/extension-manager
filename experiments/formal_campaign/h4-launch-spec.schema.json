{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-h4-launch-spec/v1",
  "type": "object",
  "required": ["schema", "arms", "health_url", "endpoint_url", "host", "port", "startup_timeout_seconds", "container_digest", "device_cleanup_command"],
  "properties": {
    "schema": {"const": "ecpa-h4-launch-spec/v1"},
    "arms": {"type": "object", "required": ["vanilla-vllm-entry-points", "manual-integration", "ecpa"], "additionalProperties": false, "properties": {
      "vanilla-vllm-entry-points": {"$ref": "#/definitions/arm"}, "manual-integration": {"$ref": "#/definitions/arm"}, "ecpa": {"$ref": "#/definitions/arm"}
    }},
    "health_url": {"type": "string", "pattern": "^http://"}, "endpoint_url": {"type": "string", "pattern": "^http://"}, "host": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "startup_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}, "container_digest": {"$ref": "#/definitions/digest"}, "device_cleanup_command": {"$ref": "#/definitions/command"}, "npu_memory_command": {"$ref": "#/definitions/command"}
  },
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "arm": {"type": "object", "required": ["server_command", "environment", "phase_commands", "evidence_paths", "served_model"], "properties": {"server_command": {"$ref": "#/definitions/command"}, "environment": {"type": "object", "additionalProperties": {"type": "string"}}, "unset_environment": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}, "phase_commands": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/definitions/command"}}}, "evidence_paths": {"type": "array", "items": {"type": "string"}}, "served_model": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
