{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-h4-deployment-receipt/v2",
  "type": "object",
  "required": [
    "schema",
    "registration_state",
    "admissible",
    "evidence_mode",
    "campaign_sha256",
    "launch_spec_sha256",
    "host_source_admission_sha256",
    "host_source_admission",
    "campaign_id",
    "cell_id",
    "arm_command_digests",
    "manager_commit",
    "host_commit",
    "accelerator_commit",
    "plugin_commits",
    "model_digest",
    "workload_digest",
    "hardware",
    "topology",
    "issuer",
    "source_provenance_policy",
    "source_provenance_observation",
    "source_provenance_protocol_binding"
  ],
  "properties": {
    "schema": {
      "const": "ecpa-h4-deployment-receipt/v2"
    },
    "registration_state": {
      "const": "registered"
    },
    "admissible": {
      "const": true
    },
    "evidence_mode": {
      "const": "formal-real"
    },
    "campaign_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launch_spec_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "host_source_admission_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "host_source_admission": {
      "type": "object",
      "required": [
        "schema",
        "repository",
        "remote",
        "candidate_commit",
        "main_commit",
        "candidate_reachable",
        "candidate_merged_to_main"
      ],
      "properties": {
        "schema": {
          "const": "ecpa-host-source-admission/v1"
        },
        "repository": {
          "const": "vLLM-HUST/vllm-hust"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "candidate_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "main_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate_reachable": {
          "const": true
        },
        "candidate_merged_to_main": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "campaign_id": {
      "const": "H4-matched-cost-v1"
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "arm_command_digests": {
      "type": "object",
      "required": [
        "vanilla-vllm-entry-points",
        "manual-integration",
        "ecpa"
      ],
      "properties": {
        "vanilla-vllm-entry-points": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manual-integration": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ecpa": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "manager_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "host_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "accelerator_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "plugin_commits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "model_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hardware": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "object",
      "required": [
        "kind",
        "manager_repository",
        "manager_remote",
        "host_repository",
        "host_remote",
        "manager_main_commit",
        "host_main_commit"
      ],
      "properties": {
        "kind": {
          "const": "ecpa-h4-registration-transition/v1"
        },
        "manager_repository": {
          "const": "vLLM-HUST/extension-manager"
        },
        "manager_remote": {
          "type": "string",
          "minLength": 1
        },
        "host_repository": {
          "const": "vLLM-HUST/vllm-hust"
        },
        "host_remote": {
          "type": "string",
          "minLength": 1
        },
        "manager_main_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "host_main_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "source_provenance_policy": {
      "type": "object"
    },
    "source_provenance_observation": {
      "type": "object"
    },
    "source_provenance_protocol_binding": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
