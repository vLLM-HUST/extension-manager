{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-h4-raw-measurement/v2",
  "type": "object",
  "required": [
    "schema",
    "campaign_id",
    "cell_id",
    "start_id",
    "arm",
    "repetition",
    "arm_order",
    "workload_digest",
    "deployment_receipt_sha256",
    "artifact_sha256",
    "process_identity",
    "clock",
    "startup_start_ns",
    "ready_ns",
    "startup_phases",
    "requests",
    "resources",
    "launch_definition"
  ],
  "properties": {
    "schema": {
      "const": "ecpa-h4-raw-measurement/v2"
    },
    "campaign_id": {
      "const": "H4-matched-cost-v1"
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "start_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "vanilla-vllm-entry-points",
        "manual-integration",
        "ecpa"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "arm_order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "workload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "deployment_receipt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_sha256": {
      "type": "object",
      "required": [
        "raw_log",
        "request_results",
        "process_snapshot",
        "cleanup_report"
      ],
      "properties": {
        "raw_log": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "request_results": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "process_snapshot": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cleanup_report": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "process_identity": {
      "type": "object",
      "required": [
        "launcher_pid",
        "launcher_start_ticks",
        "server_pid",
        "server_start_ticks",
        "boot_id"
      ],
      "properties": {
        "launcher_pid": {
          "type": "integer",
          "minimum": 1
        },
        "launcher_start_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "server_pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "server_start_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "boot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "clock": {
      "const": "CLOCK_MONOTONIC_RAW"
    },
    "startup_start_ns": {
      "type": "integer",
      "minimum": 0
    },
    "ready_ns": {
      "type": "integer",
      "minimum": 1
    },
    "startup_phases": {},
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/request"
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "cpu_ms",
        "peak_host_rss_bytes",
        "peak_device_memory_bytes",
        "process_messages",
        "evidence_bytes"
      ],
      "properties": {
        "cpu_ms": {
          "type": "number",
          "minimum": 0
        },
        "peak_host_rss_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "peak_device_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "process_messages": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "gate_open_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "failure_detection_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rollback_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "recovery_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "launch_definition": {
      "type": "object",
      "required": [
        "served_model"
      ],
      "properties": {
        "served_model": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "interval": {
      "type": "object",
      "required": [
        "start_ns",
        "end_ns"
      ],
      "properties": {
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "request_id",
        "kind",
        "dispatch_ns",
        "complete_ns",
        "status_code",
        "response_nonempty",
        "output_tokens",
        "http_request",
        "http_response",
        "response_model",
        "error"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "warmup",
            "measured"
          ]
        },
        "dispatch_ns": {
          "type": "integer",
          "minimum": 0
        },
        "complete_ns": {
          "type": "integer",
          "minimum": 0
        },
        "status_code": {
          "type": "integer",
          "minimum": 0
        },
        "response_nonempty": {
          "type": "boolean"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "http_request": {
          "$ref": "#/definitions/body"
        },
        "response_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "http_response": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "body_base64",
            "body_sha256",
            "status_code",
            "headers"
          ],
          "properties": {
            "body_base64": {
              "type": "string"
            },
            "body_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "status_code": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "required": [
        "body_base64",
        "body_sha256"
      ],
      "properties": {
        "body_base64": {
          "type": "string"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "launch_definition": {
            "required": [
              "environment"
            ],
            "properties": {
              "environment": {
                "required": [
                  "ECPA_H4_SOURCE_OWNED_PAIR"
                ],
                "properties": {
                  "ECPA_H4_SOURCE_OWNED_PAIR": {
                    "const": "1"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "startup_phases": {
            "type": "object",
            "required": [
              "discovery",
              "validation",
              "planning",
              "rendering",
              "evidence_setup",
              "worker_loading"
            ],
            "additionalProperties": false,
            "properties": {
              "discovery": {
                "type": "null"
              },
              "validation": {
                "type": "null"
              },
              "planning": {
                "type": "null"
              },
              "rendering": {
                "type": "null"
              },
              "evidence_setup": {
                "type": "null"
              },
              "worker_loading": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "startup_phases": {
            "type": "object",
            "required": [
              "discovery",
              "validation",
              "planning",
              "rendering",
              "evidence_setup",
              "worker_loading"
            ],
            "additionalProperties": false,
            "properties": {
              "discovery": {
                "$ref": "#/definitions/interval"
              },
              "validation": {
                "$ref": "#/definitions/interval"
              },
              "planning": {
                "$ref": "#/definitions/interval"
              },
              "rendering": {
                "$ref": "#/definitions/interval"
              },
              "evidence_setup": {
                "$ref": "#/definitions/interval"
              },
              "worker_loading": {
                "$ref": "#/definitions/interval"
              }
            }
          }
        }
      }
    }
  ]
}
