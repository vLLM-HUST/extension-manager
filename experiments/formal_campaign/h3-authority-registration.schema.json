{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-h3-authority-registration/v1",
  "type": "object",
  "required": ["schema", "registration_state", "evidence_class", "campaign_sha256", "authority_endpoint", "state_command_digest", "cleanup_command_digest", "starts", "review"],
  "properties": {
    "schema": {"const": "ecpa-h3-authority-registration/v1"},
    "registration_state": {"const": "reviewed"},
    "evidence_class": {"const": "formal-real"},
    "campaign_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_endpoint": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+(?:/.*)?$"},
    "state_command_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cleanup_command_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "starts": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["start_id", "arm", "repetition", "run_directory", "proxy_registration", "proxy_registration_sha256"],
        "properties": {
          "start_id": {"type": "string", "minLength": 1},
          "arm": {"enum": ["vanilla-vllm-entry-points", "manual-integration", "ecpa"]},
          "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
          "run_directory": {"type": "string", "pattern": "^/"},
          "proxy_registration_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "proxy_registration": {
            "type": "object", "additionalProperties": false,
            "required": ["schema", "evidence_class", "authority", "proxy_command_digest", "review_receipt_sha256", "reviewer_kind", "proxy_source_sha256", "public_port", "backend_port", "predecessor_port", "grant_holder", "grant_token", "grant_expires_at"],
            "properties": {
              "schema": {"const": "ecpa-formal-proxy-registration/v1"}, "evidence_class": {"const": "formal-real"},
              "authority": {"const": "independent-loopback-proxy"}, "proxy_command_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "review_receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "reviewer_kind": {"const": "automated-independent"},
              "proxy_source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "public_port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "backend_port": {"type": "integer", "minimum": 1, "maximum": 65535}, "predecessor_port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "grant_holder": {"type": "string", "minLength": 1}, "grant_token": {"type": "integer", "minimum": 1}, "grant_expires_at": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_kind", "verdict", "subject_sha256"],
      "properties": {"reviewer_kind": {"const": "automated-independent"}, "verdict": {"const": "APPROVED"}, "subject_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    }
  },
  "additionalProperties": false
}
