        },
        "device_memory_bytes": {
          "$ref": "#/definitions/h4metrics/properties/device_memory_bytes"
        },
        "process_messages": {
          "$ref": "#/definitions/h4metrics/properties/process_messages"
        },
        "evidence_bytes": {
          "$ref": "#/definitions/h4metrics/properties/evidence_bytes"
        },
        "gate_open_ms": {
          "$ref": "#/definitions/h4metrics/properties/gate_open_ms"
        },
        "failure_detection_ms": {
          "$ref": "#/definitions/h4metrics/properties/failure_detection_ms"
        },
        "rollback_ms": {
          "$ref": "#/definitions/h4metrics/properties/rollback_ms"
        },
        "recovery_ms": {
          "$ref": "#/definitions/h4metrics/properties/recovery_ms"
        },
        "measurement_scope": {
          "const": "actual-product-Popen-to-health200"
        }
      },
      "additionalProperties": false
    },
