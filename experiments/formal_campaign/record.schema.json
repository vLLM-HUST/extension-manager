{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-formal-campaign-record/v1",
  "type": "object",
  "required": [
    "schema",
    "campaign_id",
    "evidence_class",
    "deployment",
    "cell_id",
    "start_id",
    "status",
    "arm",
    "repetition",
    "arm_order",
    "identity",
    "artifacts",
    "cleanup",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "ecpa-formal-campaign-record/v1"
    },
    "measurement_domain": {
      "enum": [
        "ecpa-h4-sampled-native-record/v1",
        "ecpa-h4-conditional-source-owned/v1"
      ]
    },
    "campaign_id": {
      "enum": [
        "H3-transactional-recovery-v1",
        "H4-matched-cost-v1"
      ]
    },
    "evidence_class": {
      "const": "formal-real"
    },
    "deployment": {
      "type": "object",
      "required": [
        "registration_state",
        "receipt_sha256"
      ],
      "properties": {
        "registration_state": {
          "const": "registered"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "start_id": {
      "type": "string",
      "minLength": 1
    },
    "process_identity": {
      "oneOf": [
        {
          "$ref": "#/definitions/processIdentity"
        },
        {
          "$ref": "#/definitions/h3ProcessIdentity"
        }
      ]
    },
    "status": {
      "enum": [
        "complete",
        "failed"
      ]
    },
    "arm": {
      "enum": [
        "vanilla-vllm-entry-points",
        "manual-integration",
        "ecpa"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "arm_order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "identity": {
      "type": "object",
      "required": [
        "manager_commit",
        "host_commit",
        "accelerator_commit",
        "plugin_commits",
        "provider_versions",
        "model_digest",
        "workload_digest",
        "hardware",
        "topology",
        "warm_state",
        "container_digest"
      ],
      "properties": {
        "manager_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "host_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "accelerator_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "plugin_commits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "provider_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workload_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "warm_state": {
          "enum": [
            "cold",
            "warm",
            "controlled-mixed"
          ]
        },
        "container_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "deployment_receipt",
        "raw_log",
        "request_results",
        "process_snapshot",
        "cleanup_report"
      ],
      "additionalProperties": false,
      "properties": {
        "deployment_receipt": {
          "$ref": "#/definitions/artifact"
        },
        "authority_registration": {
          "$ref": "#/definitions/artifact"
        },
        "authority_chain": {
          "$ref": "#/definitions/artifact"
        },
        "authority_journal": {
          "$ref": "#/definitions/artifact"
        },
        "raw_log": {
          "$ref": "#/definitions/artifact"
        },
        "request_results": {
          "$ref": "#/definitions/artifact"
        },
        "process_snapshot": {
          "$ref": "#/definitions/artifact"
        },
        "cleanup_report": {
          "$ref": "#/definitions/artifact"
        },
        "raw_measurement": {
          "$ref": "#/definitions/artifact"
        },
        "raw_recovery": {
          "$ref": "#/definitions/artifact"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "processes_reclaimed",
        "ports_reclaimed",
        "devices_reclaimed"
      ],
      "properties": {
        "processes_reclaimed": {
          "type": "boolean"
        },
        "ports_reclaimed": {
          "type": "boolean"
        },
        "devices_reclaimed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object"
    },
    "failure": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "class": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "class"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "failure"
        ],
        "properties": {
          "failure": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_id": {
            "const": "H3-transactional-recovery-v1"
          },
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "required": [
          "process_identity"
        ],
        "properties": {
          "process_identity": {
            "$ref": "#/definitions/h3ProcessIdentity"
          },
          "artifacts": {
            "required": [
              "raw_recovery",
              "authority_registration"
            ]
          },
          "metrics": {
            "$ref": "#/definitions/h3metrics"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_id": {
            "const": "H4-matched-cost-v1"
          }
        }
      },
      "then": {
        "required": [
          "process_identity"
        ],
        "properties": {
          "artifacts": {
            "required": [
              "raw_measurement"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_id": {
            "const": "H4-matched-cost-v1"
          },
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "metrics": {
            "oneOf": [
              {
                "$ref": "#/definitions/h4metrics"
              },
              {
                "$ref": "#/definitions/h4SourceOwnedMetrics"
              },
              {
                "$ref": "#/definitions/h4SampledSourceOwnedMetrics"
              },
              {
                "$ref": "#/definitions/h4ConditionalSourceOwnedMetrics"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "measurement_domain"
        ],
        "properties": {
          "measurement_domain": {
            "const": "ecpa-h4-sampled-native-record/v1"
          }
        }
      },
      "then": {
        "properties": {
          "campaign_id": {
            "const": "H4-matched-cost-v1"
          },
          "cell_id": {
            "const": "compatible-resource-pair.sampled-invocation"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "metrics"
        ],
        "properties": {
          "metrics": {
            "required": [
              "measurement_scope"
            ],
            "properties": {
              "measurement_scope": {
                "const": "actual-product-Popen-to-health200; native-sampled-control-costs-unobserved"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "measurement_domain"
        ]
      }
    },
    {
      "if": {
        "required": [
          "measurement_domain"
        ],
        "properties": {
          "measurement_domain": {
            "const": "ecpa-h4-conditional-source-owned/v1"
          }
        }
      },
      "then": {
        "properties": {
          "campaign_id": {
            "const": "H4-matched-cost-v1"
          },
          "cell_id": {
            "enum": [
              "conditional-resource-pair.lifecycle-only",
              "conditional-resource-pair.sampled-invocation"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "processIdentity": {
      "type": "object",
      "required": [
        "launcher_pid",
        "launcher_start_ticks",
        "server_pid",
        "server_start_ticks",
        "boot_id"
      ],
      "properties": {
        "launcher_pid": {
          "type": "integer",
          "minimum": 1
        },
        "launcher_start_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "server_pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "server_start_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "boot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "h3ProcessIdentity": {
      "type": "object",
      "required": [
        "launcher_pid",
        "launcher_start_ticks",
        "fault_target_pid",
        "fault_target_start_ticks",
        "boot_id"
      ],
      "properties": {
        "launcher_pid": {
          "type": "integer",
          "minimum": 1
        },
        "launcher_start_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "fault_target_pid": {
          "type": "integer",
          "minimum": 1
        },
        "fault_target_start_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "boot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "h3metrics": {
      "type": "object",
      "required": [
        "injected_failure",
        "objective_met",
        "unsupported_tuple_served",
        "predecessor_preserved",
        "functional_correctness",
        "evidence_identity_preserved",
        "recovery_ms",
        "lost_requests",
        "duplicated_requests",
        "operator_actions",
        "final_route",
        "rollback_classification"
      ],
      "properties": {
        "injected_failure": {
          "type": "boolean"
        },
        "objective_met": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unsupported_tuple_served": {
          "type": "boolean"
        },
        "predecessor_preserved": {
          "type": "boolean"
        },
        "functional_correctness": {
          "type": "boolean"
        },
        "evidence_identity_preserved": {
          "type": "boolean"
        },
        "recovery_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lost_requests": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duplicated_requests": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "post_recovery_observed_lost_requests": {
          "type": "integer",
          "minimum": 0
        },
        "crash_window_coverage": {
          "enum": [
            "missing",
            "complete-finite-delivery-window"
          ]
        },
        "operator_actions": {
          "type": "integer",
          "minimum": 0
        },
        "final_route": {
          "type": "string",
          "minLength": 1
        },
        "rollback_classification": {
          "enum": [
            "automatic-restoration",
            "failed-safe",
            "bounded-operator-action",
            "not-applicable"
          ]
        }
      },
      "additionalProperties": false
    },
    "h4SourceOwnedMetrics": {
      "type": "object",
      "required": [
        "startup_phases_ms",
        "throughput",
        "latency_median_ms",
        "latency_p95_ms",
        "latency_p99_ms",
        "cpu_ms",
        "host_memory_bytes",
        "device_memory_bytes",
        "process_messages",
        "evidence_bytes",
        "gate_open_ms",
        "failure_detection_ms",
        "rollback_ms",
        "recovery_ms",
        "measurement_scope"
      ],
      "properties": {
        "startup_phases_ms": {
          "type": "object",
          "required": [
            "discovery",
            "validation",
            "planning",
            "rendering",
            "worker_loading",
            "evidence_setup",
            "total"
          ],
          "additionalProperties": false,
          "properties": {
            "discovery": {
              "type": "null"
            },
            "validation": {
              "type": "null"
            },
            "planning": {
              "type": "null"
            },
            "rendering": {
              "type": "null"
            },
            "worker_loading": {
              "type": "null"
            },
            "evidence_setup": {
              "type": "null"
            },
            "total": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "throughput": {
          "$ref": "#/definitions/h4metrics/properties/throughput"
        },
        "latency_median_ms": {
          "$ref": "#/definitions/h4metrics/properties/latency_median_ms"
        },
        "latency_p95_ms": {
          "$ref": "#/definitions/h4metrics/properties/latency_p95_ms"
        },
        "latency_p99_ms": {
