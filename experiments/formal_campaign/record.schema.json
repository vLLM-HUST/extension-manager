{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-formal-campaign-record/v1",
  "type": "object",
  "required": ["schema", "campaign_id", "evidence_class", "deployment", "cell_id", "start_id", "status", "arm", "repetition", "arm_order", "identity", "artifacts", "cleanup", "metrics"],
  "properties": {
    "schema": {"const": "ecpa-formal-campaign-record/v1"},
    "campaign_id": {"enum": ["H3-transactional-recovery-v1", "H4-matched-cost-v1"]},
    "evidence_class": {"const": "formal-real"},
    "deployment": {
      "type": "object",
      "required": ["registration_state", "receipt_sha256"],
      "properties": {
        "registration_state": {"const": "registered"},
        "receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "cell_id": {"type": "string", "minLength": 1},
    "start_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "failed"]},
    "arm": {"enum": ["vanilla-vllm-entry-points", "manual-integration", "ecpa"]},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "arm_order": {"type": "integer", "minimum": 1, "maximum": 3},
    "identity": {
      "type": "object",
      "required": ["manager_commit", "host_commit", "accelerator_commit", "plugin_commits", "provider_versions", "model_digest", "workload_digest", "hardware", "topology", "warm_state", "container_digest"],
      "properties": {
        "manager_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "host_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "accelerator_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "plugin_commits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
        "provider_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "model_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "workload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hardware": {"type": "string", "minLength": 1},
        "topology": {"type": "string", "minLength": 1},
        "warm_state": {"enum": ["cold", "warm", "controlled-mixed"]},
        "container_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["raw_log", "request_results", "process_snapshot", "cleanup_report"],
      "additionalProperties": false,
      "properties": {
        "raw_log": {"$ref": "#/definitions/artifact"},
        "request_results": {"$ref": "#/definitions/artifact"},
        "process_snapshot": {"$ref": "#/definitions/artifact"},
        "cleanup_report": {"$ref": "#/definitions/artifact"}
      }
    },
    "cleanup": {
      "type": "object",
      "required": ["processes_reclaimed", "ports_reclaimed", "devices_reclaimed"],
      "properties": {
        "processes_reclaimed": {"type": "boolean"},
        "ports_reclaimed": {"type": "boolean"},
        "devices_reclaimed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "metrics": {"type": "object"},
    "failure": {
      "type": ["object", "null"],
      "properties": {"phase": {"type": "string"}, "class": {"type": "string"}},
      "required": ["phase", "class"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"required": ["failure"], "properties": {"failure": {"type": "object"}}}},
    {"if": {"properties": {"campaign_id": {"const": "H3-transactional-recovery-v1"}}}, "then": {"properties": {"metrics": {"$ref": "#/definitions/h3metrics"}}}},
    {"if": {"properties": {"campaign_id": {"const": "H4-matched-cost-v1"}, "status": {"const": "complete"}}}, "then": {"properties": {"metrics": {"$ref": "#/definitions/h4metrics"}}}}
  ],
  "definitions": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
      "additionalProperties": false
    },
    "h3metrics": {
      "type": "object",
      "required": ["injected_failure", "objective_met", "unsupported_tuple_served", "predecessor_preserved", "functional_correctness", "evidence_identity_preserved", "recovery_ms", "lost_requests", "duplicated_requests", "operator_actions", "final_route", "rollback_classification"],
      "properties": {
        "injected_failure": {"type": "boolean"},
        "objective_met": {"type": "boolean"},
        "unsupported_tuple_served": {"type": "boolean"},
        "predecessor_preserved": {"type": "boolean"},
        "functional_correctness": {"type": "boolean"},
        "evidence_identity_preserved": {"type": "boolean"},
        "recovery_ms": {"type": ["number", "null"], "minimum": 0},
        "lost_requests": {"type": "integer", "minimum": 0},
        "duplicated_requests": {"type": "integer", "minimum": 0},
        "operator_actions": {"type": "integer", "minimum": 0},
        "final_route": {"type": "string", "minLength": 1},
        "rollback_classification": {"enum": ["automatic-restoration", "failed-safe", "bounded-operator-action", "not-applicable"]}
      },
      "additionalProperties": false
    },
    "h4metrics": {
      "type": "object",
      "required": ["startup_phases_ms", "throughput", "latency_median_ms", "latency_p95_ms", "latency_p99_ms", "cpu_ms", "host_memory_bytes", "device_memory_bytes", "process_messages", "evidence_bytes", "gate_open_ms", "failure_detection_ms", "rollback_ms", "recovery_ms"],
      "properties": {
        "startup_phases_ms": {
          "type": "object",
          "required": ["discovery", "validation", "planning", "rendering", "worker_loading", "evidence_setup", "total"],
          "additionalProperties": false,
          "properties": {
            "discovery": {"type": "number", "minimum": 0}, "validation": {"type": "number", "minimum": 0}, "planning": {"type": "number", "minimum": 0}, "rendering": {"type": "number", "minimum": 0}, "worker_loading": {"type": "number", "minimum": 0}, "evidence_setup": {"type": "number", "minimum": 0}, "total": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "throughput": {"type": "number", "exclusiveMinimum": 0},
        "latency_median_ms": {"type": "number", "minimum": 0},
        "latency_p95_ms": {"type": "number", "minimum": 0},
        "latency_p99_ms": {"type": "number", "minimum": 0},
        "cpu_ms": {"type": "number", "minimum": 0},
        "host_memory_bytes": {"type": "integer", "minimum": 0},
        "device_memory_bytes": {"type": "integer", "minimum": 0},
        "process_messages": {"type": "integer", "minimum": 0},
        "evidence_bytes": {"type": "integer", "minimum": 0},
        "gate_open_ms": {"type": ["number", "null"], "minimum": 0},
        "failure_detection_ms": {"type": ["number", "null"], "minimum": 0},
        "rollback_ms": {"type": ["number", "null"], "minimum": 0},
        "recovery_ms": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
