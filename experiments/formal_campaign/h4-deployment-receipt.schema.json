{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecpa-h4-deployment-receipt/v1",
  "type": "object",
  "required": ["schema", "registration_state", "admissible", "evidence_mode", "campaign_sha256", "campaign_id", "cell_id", "arm_command_digests", "manager_commit", "host_commit", "accelerator_commit", "plugin_commits", "model_digest", "workload_digest", "hardware", "topology"],
  "properties": {
    "schema": {"const": "ecpa-h4-deployment-receipt/v1"},
    "registration_state": {"const": "registered"},
    "admissible": {"const": true},
    "evidence_mode": {"const": "formal-real"},
    "campaign_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "campaign_id": {"const": "H4-matched-cost-v1"},
    "cell_id": {"type": "string", "minLength": 1},
    "arm_command_digests": {
      "type": "object",
      "required": ["vanilla-vllm-entry-points", "manual-integration", "ecpa"],
      "properties": {
        "vanilla-vllm-entry-points": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "manual-integration": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "ecpa": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "manager_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "accelerator_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plugin_commits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "model_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hardware": {"type": "string", "minLength": 1},
    "topology": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
