{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema", "classification", "case_id", "order_id", "campaign_sha256", "oracle_sha256", "planner_decision", "runtime_evidence"],
  "properties": {
    "schema": {"const": "ecpa-h2-formal-runtime-record/v1"},
    "classification": {"const": "formal-real-host-composition"},
    "case_id": {"type": "string", "minLength": 1},
    "order_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "oracle_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "planner_decision": {"enum": ["admit", "reject"]},
    "runtime_evidence": {
      "type": "object",
      "required": ["host_started", "model_loaded", "workload_completed", "process_owned_observation", "cleanup_complete", "receipt_sha256"],
      "properties": {
        "host_started": {"type": "boolean"},
        "model_loaded": {"type": "boolean"},
        "workload_completed": {"type": "boolean"},
        "process_owned_observation": {"type": "boolean"},
        "cleanup_complete": {"type": "boolean"},
        "receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
