{
  "schema_version": "0.3-experimental",
  "extension_id": "org.vllm-hust.latchmoe",
  "extension_version": "0.3.0",
  "kind": "runtime_bridge",
  "host": {
    "provider": "vllm",
    "name": "vllm",
    "version_range": ">=0.28.1rc1.dev319,<0.29",
    "api_range": ">=1,<2"
  },
  "runtime": {
    "type": "python",
    "process_scope": "vllm-ascend-worker",
    "isolation": "trusted_in_process"
  },
  "lifecycle_owner": "vllm",
  "protocols": [
    {
      "name": "vllm.ascend.moe-offload-seam",
      "version_range": ">=2,<3"
    }
  ],
  "implementation": [
    {
      "type": "python_module",
      "module": "vllm_moe_offload_ascend",
      "object": "register",
      "status": "active"
    }
  ],
  "requires_services": [],
  "requires_extensions": [],
  "resource_claims": [
    {
      "resource": "vllm-ascend.worker.moe-offload",
      "scope": "vllm-process",
      "mode": "exclusive"
    }
  ],
  "components": [
    {
      "component_id": "moe-offload-runtime",
      "contracts": [
        "vllm.ascend.moe-offload.v1"
      ],
      "execution_planes": [
        "worker",
        "device"
      ],
      "isolation": "trusted_in_process",
      "implementation_ref": "vllm_moe_offload_ascend:register",
      "permissions": [
        "device_access",
        "filesystem_read",
        "filesystem_write"
      ]
    }
  ],
  "activation": {
    "entry_points": [
      {
        "group": "vllm.general_plugins",
        "name": "moe_offload_ascend"
      }
    ],
    "environment": {
      "VLLM_ASCEND_MOE_OFFLOAD_GB": "14",
      "VLLM_ASCEND_MOE_OFFLOAD_SEW_DATAPLANE": "1",
      "VLLM_ASCEND_MOE_OFFLOAD_MAX_NUM_SEQS_HINT": "4",
      "VLLM_ENGINE_ENABLE_PREFIX_CACHING": "0",
      "VLLM_ASCEND_MOE_OFFLOAD_INDEXED_WAVE_MODE": "eager"
    },
    "additional_config": {
      "latchmoe_release_scope": {
        "accelerator": "ascend",
        "model": "Qwen3-30B-A3B",
        "dtype": "bfloat16",
        "tensor_parallel_size": 1,
        "device_count": 1,
        "piecewise": true,
        "prefix_cache": false,
        "indexed_wave_modes": ["eager", "graph"],
        "status": "functional_scope",
        "excluded": [
          "Qwen3.5 TP2",
          "APC",
          "MTP2",
          "FULL_AND_PIECEWISE",
          "c=8 concurrency",
          "offered-load performance"
        ]
      },
      "_manager_runtime_qualification": {
        "accelerator": "ascend",
        "execution_mode": "piecewise",
        "model": "Qwen3-30B-A3B",
        "tensor_parallel_size": 1,
        "status": "functional_scope",
        "evidence": "repro/paper/release_validation.md"
      }
    }
  }
}
