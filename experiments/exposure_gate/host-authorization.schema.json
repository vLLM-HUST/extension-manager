{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frozen loopback host-observation authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_path",
    "journal_dir",
    "journal_device",
    "journal_inode",
    "launch_id",
    "controller_instance",
    "local_host",
    "bindings",
    "required_processes"
  ],
  "properties": {
    "schema": {"const": "ecpa-loopback-host-authorization/v1"},
    "plan_path": {"type": "string", "pattern": "^/"},
    "journal_dir": {"type": "string", "pattern": "^/"},
    "journal_device": {"type": "integer", "minimum": 0},
    "journal_inode": {"type": "integer", "minimum": 1},
    "launch_id": {"type": "string", "minLength": 1},
    "controller_instance": {"type": "string", "minLength": 1},
    "local_host": {"type": "string", "minLength": 1},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "name", "value", "plugin_id", "obligation"],
        "properties": {
          "group": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "plugin_id": {"type": "string", "minLength": 1},
          "obligation": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "role", "ordinal", "process_epoch"],
        "properties": {
          "host": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "ordinal": {"type": "integer", "minimum": 0},
          "process_epoch": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
