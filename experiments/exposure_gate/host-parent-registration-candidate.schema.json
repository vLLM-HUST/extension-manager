{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "type": "object",
  "required": ["schema", "classification", "formal_result", "performance_result", "registration", "manager_review_context", "host_source", "wheel", "functional_preflight", "review", "non_claims"],
  "properties": {
    "schema": {"const": "ecpa-host-parent-identity-producer-candidate/v1"},
    "classification": {"const": "source-bound-non-admitting-functional-preflight"},
    "formal_result": {"const": false},
    "performance_result": {"const": false},
    "registration": {
      "type": "object",
      "required": ["state", "admissible", "blockers"],
      "properties": {
        "state": {"const": "blocked"},
        "admissible": {"const": false},
        "blockers": {"const": ["host-candidate-commit-not-repository-reachable", "host-candidate-commit-not-merged"]}
      },
      "additionalProperties": false
    },
    "manager_review_context": {
      "type": "object",
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"const": "vLLM-HUST/extension-manager"},
        "commit": {"$ref": "#/definitions/sha"},
        "tree": {"$ref": "#/definitions/sha"}
      },
      "additionalProperties": false
    },
    "host_source": {
      "type": "object",
      "required": ["repository", "base_commit", "candidate_commit", "candidate_parent", "candidate_tree", "changed_paths", "source_blobs", "patch_sha256", "observed_state", "remote_ref", "pull_request", "merge_commit", "remote_observation"],
      "properties": {
        "repository": {"const": "vLLM-HUST/vllm-hust"},
        "base_commit": {"$ref": "#/definitions/sha"},
        "candidate_commit": {"$ref": "#/definitions/sha"},
        "candidate_parent": {"$ref": "#/definitions/sha"},
        "candidate_tree": {"$ref": "#/definitions/sha"},
        "changed_paths": {"const": ["tests/plugins_tests/test_ecpa_plugin_evidence.py", "vllm/entrypoints/cli/main.py"]},
        "source_blobs": {"type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": {"$ref": "#/definitions/sha"}},
        "patch_sha256": {"$ref": "#/definitions/digest"},
        "observed_state": {"const": "local-only"},
        "remote_ref": {"type": "null"},
        "pull_request": {"type": "null"},
        "merge_commit": {"type": "null"},
        "remote_observation": {
          "type": "object",
          "required": ["method", "observed_at", "main_commit", "candidate_reachable", "matching_refs"],
          "properties": {
            "method": {"const": "git-ls-remote-all-refs"},
            "observed_at": {"const": "2026-10-13"},
            "main_commit": {"$ref": "#/definitions/sha"},
            "candidate_reachable": {"const": false},
            "matching_refs": {"const": []}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "wheel": {
      "type": "object",
      "required": ["filename", "sha256", "size_bytes", "tag"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/digest"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "tag": {"const": "cp312-cp312-linux_aarch64"}
      },
      "additionalProperties": false
    },
    "functional_preflight": {
      "type": "object",
      "required": ["artifact_path", "artifact_sha256", "classification", "formal_result", "performance_result", "runtime_candidate_commit", "runtime_wheel_sha256", "executed_manager_commit", "accelerator_plugin_commit", "hardware", "topology", "host_assigned_roles", "cleanup_passed"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/definitions/digest"},
        "classification": {"const": "unregistered-functional-preflight"},
        "formal_result": {"const": false},
        "performance_result": {"const": false},
        "runtime_candidate_commit": {"$ref": "#/definitions/sha"},
        "runtime_wheel_sha256": {"$ref": "#/definitions/digest"},
        "executed_manager_commit": {"$ref": "#/definitions/sha"},
        "accelerator_plugin_commit": {"$ref": "#/definitions/sha"},
        "hardware": {"const": "2x Ascend 910B2"},
        "topology": {"const": "single-host TP2 eager"},
        "host_assigned_roles": {"const": ["api-server:0", "engine-core-scheduler:0", "worker:0", "worker:1"]},
        "cleanup_passed": {"const": true}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["schema", "reviewer_kind", "subject_digest", "checks", "verdict", "blockers", "receipt_digest"],
      "properties": {
        "schema": {"const": "ecpa-host-parent-identity-automated-review/v1"},
        "reviewer_kind": {"const": "automated-independent"},
        "subject_digest": {"$ref": "#/definitions/digest"},
        "checks": {"type": "object", "minProperties": 6, "additionalProperties": {"enum": ["PASS", "FAIL-CLOSED"]}},
        "verdict": {"const": "BLOCKED"},
        "blockers": {"const": ["host-candidate-commit-not-repository-reachable", "host-candidate-commit-not-merged"]},
        "receipt_digest": {"$ref": "#/definitions/digest"}
      },
      "additionalProperties": false
    },
    "non_claims": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
