{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Registration-bound formal loopback host authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_path",
    "journal_dir",
    "journal_device",
    "journal_inode",
    "launch_id",
    "controller_instance",
    "candidate_generation",
    "membership_epoch",
    "target_set_sha256",
    "process_membership",
    "process_membership_sha256",
    "registration",
    "registration_sha256",
    "local_host",
    "bindings",
    "required_processes"
  ],
  "properties": {
    "schema": {
      "const": "ecpa-loopback-formal-host-authorization/v1"
    },
    "plan_path": {
      "type": "string",
      "pattern": "^/"
    },
    "journal_dir": {
      "type": "string",
      "pattern": "^/"
    },
    "journal_device": {
      "type": "integer",
      "minimum": 0
    },
    "journal_inode": {
      "type": "integer",
      "minimum": 1
    },
    "launch_id": {
      "type": "string",
      "minLength": 1
    },
    "controller_instance": {
      "type": "string",
      "minLength": 1
    },
    "candidate_generation": {
      "type": "integer",
      "minimum": 1
    },
    "membership_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "target_set_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "process_membership_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registration_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "local_host": {
      "type": "string",
      "minLength": 1
    },
    "process_membership": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "role",
          "ordinal",
          "process_epoch",
          "pid",
          "start_identity"
        ],
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "api-server",
              "engine-core-scheduler",
              "worker"
            ]
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "process_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "start_identity": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "evidence_class",
        "authority",
        "proxy_command_digest",
        "review_receipt_sha256",
        "reviewer_kind",
        "proxy_source_sha256",
        "public_port",
        "backend_port",
        "predecessor_port",
        "grant_holder",
        "grant_token",
        "grant_expires_at"
      ],
      "properties": {
        "schema": {
          "const": "ecpa-formal-proxy-registration/v1"
        },
        "evidence_class": {
          "const": "formal-real"
        },
        "authority": {
          "const": "independent-loopback-proxy"
        },
        "proxy_command_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "review_receipt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reviewer_kind": {
          "const": "automated-independent"
        },
        "proxy_source_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "public_port": {
          "const": 8187
        },
        "backend_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "predecessor_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "grant_holder": {
          "type": "string",
          "minLength": 1
        },
        "grant_token": {
          "type": "integer",
          "minimum": 1
        },
        "grant_expires_at": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "name",
          "value",
          "plugin_id",
          "obligation"
        ],
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "plugin_id": {
            "type": "string",
            "minLength": 1
          },
          "obligation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "role",
          "ordinal",
          "process_epoch"
        ],
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "process_epoch": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
